# Dependencies, build output, and test artefacts.
/node_modules/
/dist/
/coverage/
/.nyc_output/
*.tsbuildinfo
*.tgz
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files and local runtime state.
.env
.env.*
!.env.example
/.agent-cli/
/.claude/
/.agents/
/.cache/
/tmp/
/temp/

# Local databases, credentials, and machine-specific settings.
*.db
*.db-*
*.sqlite
*.sqlite3
*.pem
*.key
id_rsa*
id_ed25519*
*.local.json

# Editor and operating-system files.
/.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Upstream/reference checkouts. Remove these rules only if you intentionally
# want to publish them as submodules or vendored source.
/opencode/
/qwen-code/
/ascend310p-operator-porting/

# Local agent-generated scratch files.
/matmul.py

# Local prompt drafts and reports.
/*PROMPT*.md
/*prompt*.md
/prompts/*.md
/prompts/**/*.md
/.prompts/*.md
/.prompts/**/*.md
*REPORT*.md
*PROMPT*.md
